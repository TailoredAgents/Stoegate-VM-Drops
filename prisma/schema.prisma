}

model ImportRow {
  id              String           @id @default(uuid()) @db.Uuid
  importBatchId   String           @db.Uuid
  rowNumber       Int
  status          ImportRowStatus
  normalizedPhone String?
  mappedData      Json
  rawData         Json
  errorMessage    String?
  createdAt       DateTime         @default(now())
