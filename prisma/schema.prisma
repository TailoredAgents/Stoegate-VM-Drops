generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
}

enum CampaignStatus {
  DRAFT
  DATA_READY
  PREVIEW_GENERATING
  PREVIEW_READY
  APPROVED
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum CampaignKind {
  LEGACY_RVM
  SMS
}

enum SmsTemplateStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum SmsComplianceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SmsMessageStatus {
  PENDING
  SCHEDULED
  DRY_RUN
  QUEUED
  SUBMITTING
  SUBMISSION_UNKNOWN
  ACCEPTED
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  REPLIED
  SUPPRESSED
  CANCELED
}

enum SmsAttemptStatus {
  STARTED
  ACCEPTED
  FAILED
  UNKNOWN
}

enum SmsConversationStatus {
  OPEN
  CLOSED
  SUPPRESSED
}

enum SmsInboundClassification {
  UNCLASSIFIED
  INTERESTED
  MAYBE
  QUALIFIED_LEAD
  FOLLOW_UP
  NOT_INTERESTED
  PROPERTY_SOLD
  AGENT
  HOSTILE
  WRONG_NUMBER
  OPT_OUT
  OTHER
  NEEDS_REVIEW
}

enum SmsConsentStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
  EXPIRED
}

enum SmsConsentBasis {
  UNKNOWN
  EXPRESS_WRITTEN
  EXPRESS
  PRIOR_BUSINESS_RELATIONSHIP
  OTHER
}

enum SmsUsageKind {
  ATTEMPT
  ACCEPTED
  DELIVERED
}

enum ProviderDiagnosticStatus {
  PASSED
  FAILED
}

enum ProviderApprovalDecision {
  APPROVED
  REVOKED
}

enum ImportStatus {
  STAGING
  ANALYZED
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  ELIGIBLE
  INVALID_PHONE
  DUPLICATE_PHONE
  DUPLICATE_PHONE_PROPERTY
  SUPPRESSED
  MISSING_REQUIRED
}

enum CampaignContactStatus {
  ELIGIBLE
  PREVIEW_READY
  /// Legacy RVM preparation state.
  AUDIO_PENDING
  /// Legacy RVM preparation state.
  AUDIO_READY
  DRY_RUN
  QUEUED
  SENDING
  ACCEPTED
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  OPTED_OUT
  SUPPRESSED
  SKIPPED
}

/// Legacy RVM/TTS enum. New SMS flows must not depend on it.
enum AudioStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// Legacy RVM/TTS enum. Retained to preserve historical billing records.
enum AudioBillingDisposition {
  BILLABLE_GENERATION
  DRY_RUN
}

/// Legacy RVM provider enum. Retained for read-only historical data.
enum DropStatus {
  PENDING
  DRY_RUN
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

/// Legacy voice-callback outcomes. SMS and cold-call outcomes use OutreachEvent.
enum CallbackOutcomeType {
  CALLBACK
  INTERESTED
  QUALIFIED_LEAD
  NOT_INTERESTED
  WRONG_NUMBER
  OPT_OUT
  FOLLOW_UP
  CONTRACT
  CLOSED
}

enum AttributionChannel {
  /// Legacy RVM callback attribution retained for historical records only.
  RVM_CALLBACK
  SMS
  COLD_CALL
  OTHER
}

enum OutreachChannel {
  /// Legacy RVM event channel retained for historical records only.
  RVM
  SMS
  COLD_CALL
  SYSTEM
}

enum OutreachSequenceState {
  /// Legacy RVM states retained for historical sequences only.
  RVM_PENDING
  RVM_SENT
  RVM_SUCCESS
  RVM_FAILED
  RVM_CALLBACK
  RVM_NO_RESPONSE
  /// Legacy external-SMS handoff state retained for historical sequences only.
  SMS_NOT_YET_ELIGIBLE
  SMS_PENDING
  SMS_ELIGIBLE
  SMS_SCHEDULED
  SMS_DRY_RUN
  SMS_QUEUED
  SMS_SENDING
  SMS_SUBMISSION_UNKNOWN
  SMS_ACCEPTED
  SMS_SENT
  SMS_DELIVERED
  SMS_UNDELIVERED
  SMS_SUPPRESSED
  /// Legacy external-SMS export state retained for historical sequences only.
  SMS_EXPORTED
  /// Legacy external-SMS result state retained for historical sequences only.
  SMS_SENT_EXTERNAL
  SMS_REPLIED
  SMS_FAILED
  SMS_NO_RESPONSE
  COLD_CALL_NOT_YET_ELIGIBLE
  COLD_CALL_ELIGIBLE
  COLD_CALL_EXPORTED
  COLD_CALL_CONTACTED
  COLD_CALL_NO_ANSWER
  INTERESTED
  QUALIFIED_LEAD
  FOLLOW_UP
  NOT_INTERESTED
  WRONG_NUMBER
  OPT_OUT
  CONTRACT
  CLOSED
}

enum OutreachEventType {
  /// Legacy RVM events retained for historical sequences only.
  RVM_PENDING
  RVM_SENT
  RVM_SUCCESS
  RVM_FAILED
  RVM_CALLBACK
  RVM_NO_RESPONSE
  SMS_PENDING
  SMS_ELIGIBLE
  SMS_SCHEDULED
  SMS_DRY_RUN
  SMS_QUEUED
  SMS_SUBMISSION_STARTED
  SMS_SUBMISSION_UNKNOWN
  SMS_ACCEPTED
  SMS_SENT
  SMS_DELIVERED
  SMS_UNDELIVERED
  SMS_SUPPRESSED
  /// Legacy external-SMS events retained for historical sequences only.
  SMS_EXPORTED
  SMS_SENT_EXTERNAL
  SMS_REPLIED
  SMS_FAILED
  SMS_NO_RESPONSE
  COLD_CALL_ELIGIBLE
  COLD_CALL_EXPORTED
  COLD_CALL_CONTACTED
  COLD_CALL_NO_ANSWER
  OUTCOME_RECORDED
  SEQUENCE_EXITED
}

enum OutreachExportType {
  /// Legacy external-SMS export type retained for historical exports only.
  SMS_ELIGIBILITY
  BATCH_DIALER
}

enum ExternalOutcomeChannel {
  /// Legacy external-SMS outcome import channel retained for history only.
  SMS
  COLD_CALL
}

enum ExternalOutcomeImportStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ExternalOutcomeRowStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
}

/// Legacy RVM usage enum. Retained to preserve historical ledgers.
enum RvmUsageKind {
  ATTEMPT
  SUCCESS
}

enum SuppressionReason {
  OPT_OUT
  MANUAL
  WRONG_NUMBER
  PROVIDER_DNC
  COMPLIANCE
}

model User {
  id                          String                            @id @default(uuid()) @db.Uuid
  email                       String                            @unique
  passwordHash                String
  role                        UserRole                          @default(ADMIN)
  active                      Boolean                           @default(true)
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  sessions                    Session[]
  createdCampaigns            Campaign[]                        @relation("CampaignCreatedBy")
  approvedCampaigns           Campaign[]                        @relation("CampaignApprovedBy")
  launchedCampaigns           Campaign[]                        @relation("CampaignLaunchedBy")
  outreachEvents              OutreachEvent[]                   @relation("OutreachEventActor")
  outreachExports             OutreachExport[]                  @relation("OutreachExportCreator")
  externalOutcomeImports      ExternalOutcomeImport[]           @relation("ExternalOutcomeImportCreator")
  createdSmsTemplates         SmsTemplate[]                     @relation("SmsTemplateCreator")
  createdSmsTemplateVersions  SmsTemplateVersion[]              @relation("SmsTemplateVersionCreator")
  approvedSmsTemplateVersions SmsTemplateVersion[]              @relation("SmsTemplateVersionApprover")
  classifiedInboundMessages   SmsInboundMessage[]               @relation("SmsInboundClassifier")
  createdSmsConsentEvidence   SmsConsentEvidence[]              @relation("SmsConsentEvidenceCreator")
  createdCampaignSuppressions CampaignSuppression[]             @relation("CampaignSuppressionCreator")
  createdGlobalSuppressions   SuppressionEntry[]                @relation("GlobalSuppressionCreator")
  smsAuditEvents              SmsAuditEvent[]                   @relation("SmsAuditEventActor")
  providerDiagnosticRuns      ProviderDiagnosticRun[]           @relation("ProviderDiagnosticCheckedBy")
  providerApprovalEvents      ProviderProductionApprovalEvent[] @relation("ProviderProductionApprovalActor")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                               String                 @id @default(uuid()) @db.Uuid
  name                             String
  sourceName                       String?
  kind                             CampaignKind           @default(SMS)
  status                           CampaignStatus         @default(DRAFT)
  sendLimit                        Int                    @default(2000)
  smsDailyCap                      Int                    @default(2000)
  uploadedCount                    Int                    @default(0)
  eligibleCount                    Int                    @default(0)
  invalidCount                     Int                    @default(0)
  duplicateCount                   Int                    @default(0)
  suppressedCount                  Int                    @default(0)
  /// Legacy RVM script reference. New SMS campaigns use smsTemplateVersionId.
  scriptTemplateVersionId          String?                @db.Uuid
  /// Legacy RVM voice reference. New SMS campaigns must leave this null.
  voiceConfigurationId             String?                @db.Uuid
  smsTemplateVersionId             String?                @db.Uuid
  /// Stable provider configuration key; never store credentials here.
  smsProviderKey                   String?
  /// Provider-agnostic sender or messaging-service reference.
  smsSenderRef                     String?
  /// Non-secret provider metadata captured for reproducibility.
  smsProviderConfig                Json?
  /// Full non-secret pricing snapshot for reproducible campaign economics.
  smsCostConfig                    Json?
  smsScheduleTimezone              String                 @default("America/New_York")
  smsScheduledFor                  DateTime?
  smsSendWindowStartMinutes        Int?
  smsSendWindowEndMinutes          Int?
  smsEstimatedCostPerSegmentMicros Int                    @default(0)
  smsCurrency                      String                 @default("USD")
  smsComplianceStatus              SmsComplianceStatus    @default(DRAFT)
  smsComplianceNotes               String?
  smsColdCallDelayHours            Int                    @default(48)
  createdByUserId                  String?                @db.Uuid
  approvedAt                       DateTime?
  approvedByUserId                 String?                @db.Uuid
  launchedAt                       DateTime?
  launchedByUserId                 String?                @db.Uuid
  pausedAt                         DateTime?
  completedAt                      DateTime?
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  scriptTemplateVersion            ScriptTemplateVersion? @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration               VoiceConfiguration?    @relation(fields: [voiceConfigurationId], references: [id])
  smsTemplateVersion               SmsTemplateVersion?    @relation(fields: [smsTemplateVersionId], references: [id], onDelete: Restrict)
  createdBy                        User?                  @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy                       User?                  @relation("CampaignApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  launchedBy                       User?                  @relation("CampaignLaunchedBy", fields: [launchedByUserId], references: [id], onDelete: SetNull)
  contacts                         CampaignContact[]
  imports                          ImportBatch[]
  /// Legacy RVM callback outcomes retained for historical reporting only.
  callbackOutcomes                 CallbackOutcome[]
  outreachExports                  OutreachExport[]
  leadAttributions                 LeadAttribution[]
  campaignSuppressions             CampaignSuppression[]
  smsConsentEvidence               SmsConsentEvidence[]
  smsAuditEvents                   SmsAuditEvent[]

  @@index([status, createdAt])
  @@index([kind, status, smsScheduledFor])
  @@index([kind, sourceName, status])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([launchedByUserId])
  @@index([smsTemplateVersionId])
  @@index([smsProviderKey, status])
}

model Contact {
  id                   String                @id @default(uuid()) @db.Uuid
  normalizedPhone      String                @unique
  firstName            String?
  lastName             String?
  ownerName            String?
  source               String?
  externalId           String?
  rawData              Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  properties           ContactProperty[]
  campaigns            CampaignContact[]
  suppressions         SuppressionEntry[]
  campaignSuppressions CampaignSuppression[]
  smsConsentEvidence   SmsConsentEvidence[]
  inboundSmsMessages   SmsInboundMessage[]

  @@index([externalId])
}

model Property {
  id               String            @id @default(uuid()) @db.Uuid
  propertyAddress  String?
  streetName       String?
  city             String?
  state            String?
  postalCode       String?
  county           String?
  acreage          Decimal?          @db.Decimal(12, 3)
  propertyType     String?
  externalId       String?
  source           String?
  rawData          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         ContactProperty[]
  campaignContacts CampaignContact[]

  @@index([externalId])
  @@index([propertyAddress, city, state])
}

model ContactProperty {
  id         String   @id @default(uuid()) @db.Uuid
  contactId  String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([contactId, propertyId])
  @@index([propertyId])
}

model CampaignContact {
  id               String                @id @default(uuid()) @db.Uuid
  campaignId       String                @db.Uuid
  contactId        String                @db.Uuid
  propertyId       String?               @db.Uuid
  importRowId      String?               @unique @db.Uuid
  status           CampaignContactStatus @default(ELIGIBLE)
  isPreview        Boolean               @default(false)
  selectedForSend  Boolean               @default(false)
  renderedText     String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact          Contact               @relation(fields: [contactId], references: [id])
  property         Property?             @relation(fields: [propertyId], references: [id])
  importRow        ImportRow?            @relation(fields: [importRowId], references: [id])
  audioAssets      AudioAsset[]
  drops            Drop[]
  /// Legacy RVM callback outcomes retained for historical reporting only.
  callbackOutcomes CallbackOutcome[]
  outreachSequence OutreachSequence?
  exportItems      OutreachExportItem[]
  leadAttribution  LeadAttribution?
  smsConversation  SmsConversation?
  outboundMessages SmsOutboundMessage[]
  inboundMessages  SmsInboundMessage[]
  consentEvidence  SmsConsentEvidence[]
  smsAuditEvents   SmsAuditEvent[]

  @@unique([campaignId, contactId, propertyId])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
  @@index([campaignId, isPreview])
  @@index([campaignId, selectedForSend, status])
}

/// Legacy RVM script template. Retained for historical campaigns only.
model ScriptTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    ScriptTemplateVersion[]
}

/// Legacy RVM script version. Retained for historical campaigns and audio assets.
model ScriptTemplateVersion {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @db.Uuid
  version     Int
  body        String
  createdAt   DateTime       @default(now())
  template    ScriptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  audioAssets AudioAsset[]

  @@unique([templateId, version])
}

model SmsTemplate {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @unique
  description     String?
  active          Boolean              @default(true)
  createdByUserId String               @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       User                 @relation("SmsTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        SmsTemplateVersion[]

  @@index([active, updatedAt])
  @@index([createdByUserId])
}

model SmsTemplateVersion {
  id               String               @id @default(uuid()) @db.Uuid
  templateId       String               @db.Uuid
  version          Int
  body             String
  contentHash      String
  status           SmsTemplateStatus    @default(DRAFT)
  createdByUserId  String               @db.Uuid
  approvedByUserId String?              @db.Uuid
  approvedAt       DateTime?
  retiredAt        DateTime?
  createdAt        DateTime             @default(now())
  template         SmsTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("SmsTemplateVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?                @relation("SmsTemplateVersionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  campaigns        Campaign[]
  outboundMessages SmsOutboundMessage[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([contentHash])
  @@index([createdByUserId])
  @@index([approvedByUserId])
}

/// Legacy RVM/TTS voice configuration. New SMS flows must not reference it.
model VoiceConfiguration {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  voiceId     String
  modelId     String
  settings    Json?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaigns   Campaign[]
  audioAssets AudioAsset[]
}

/// Legacy generated RVM audio. Retained read-only to avoid historical data loss.
model AudioAsset {
  id                      String                  @id @default(uuid()) @db.Uuid
  campaignContactId       String                  @db.Uuid
  scriptTemplateVersionId String                  @db.Uuid
  voiceConfigurationId    String                  @db.Uuid
  renderedText            String
  textHash                String
  voiceId                 String
  modelId                 String
  characterCount          Int
  providerGenerationId    String?
  objectKey               String?
  contentType             String                  @default("audio/mpeg")
  durationSeconds         Float?
  estimatedCostCents      Int                     @default(0)
  billingDisposition      AudioBillingDisposition @default(BILLABLE_GENERATION)
  reuseCount              Int                     @default(0)
  status                  AudioStatus             @default(PENDING)
  generatedAt             DateTime?
  errorMessage            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  campaignContact         CampaignContact         @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  scriptTemplateVersion   ScriptTemplateVersion   @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration      VoiceConfiguration      @relation(fields: [voiceConfigurationId], references: [id])
  drops                   Drop[]
  generationUsages        AudioGenerationUsage[]

  @@unique([campaignContactId, textHash, voiceId, modelId])
  @@index([campaignContactId, status])
  @@index([textHash])
}

/// Legacy RVM/TTS generation ledger. Retained read-only for historical economics.
model AudioGenerationUsage {
  id                   String                  @id @default(uuid()) @db.Uuid
  audioAssetId         String                  @db.Uuid
  provider             String
  providerGenerationId String?
  characterCount       Int
  estimatedCostCents   Int                     @default(0)
  billingDisposition   AudioBillingDisposition
  generatedAt          DateTime
  storedAt             DateTime?
  storageError         String?
  createdAt            DateTime                @default(now())
  audioAsset           AudioAsset              @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)

  @@index([audioAssetId, generatedAt])
  @@index([billingDisposition, generatedAt])
}

/// Legacy RVM provider submission. Retained read-only for historical audit data.
model Drop {
  id                      String           @id @default(uuid()) @db.Uuid
  campaignContactId       String           @db.Uuid
  audioAssetId            String           @db.Uuid
  provider                String           @default("dropcowboy")
  providerMessageId       String?          @unique
  status                  DropStatus       @default(PENDING)
  providerResponse        Json?
  estimatedCostCents      Int              @default(0)
  providerUsageValueCents Int              @default(0)
  carrierDurationSeconds  Float?
  carrierDurationSource   String?
  queuedAt                DateTime?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  failedAt                DateTime?
  optedOutAt              DateTime?
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  campaignContact         CampaignContact  @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  audioAsset              AudioAsset       @relation(fields: [audioAssetId], references: [id])
  deliveryEvents          DeliveryEvent[]
  usageLedger             RvmUsageLedger[]

  @@unique([campaignContactId, provider])
  @@index([status, createdAt])
  @@index([campaignContactId])
}

/// Legacy Drop Cowboy delivery event. New SMS status callbacks use SmsStatusEvent.
model DeliveryEvent {
  id              String    @id @default(uuid()) @db.Uuid
  dropId          String    @db.Uuid
  providerEventId String    @unique
  eventType       String
  rawPayload      Json
  occurredAt      DateTime?
  receivedAt      DateTime  @default(now())
  drop            Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@index([dropId, receivedAt])
  @@index([eventType, receivedAt])
}

/// Legacy RVM/voice callback result. New SMS and BatchDialer outcomes use OutreachEvent and LeadAttribution.
model CallbackOutcome {
  id                  String              @id @default(uuid()) @db.Uuid
  idempotencyKey      String              @unique
  campaignId          String?             @db.Uuid
  campaignContactId   String?             @db.Uuid
  normalizedPhone     String
  outcome             CallbackOutcomeType
  attributionChannel  AttributionChannel  @default(RVM_CALLBACK)
  stonegateLeadId     String?
  summary             String?
  callbackAt          DateTime
  contractAmountCents Int?
  revenueCents        Int?
  rawPayload          Json?
  createdAt           DateTime            @default(now())
  campaign            Campaign?           @relation(fields: [campaignId], references: [id])
  campaignContact     CampaignContact?    @relation(fields: [campaignContactId], references: [id])

  @@index([normalizedPhone, callbackAt])
  @@index([campaignId, outcome])
}

model OutreachSequence {
  id                      String                     @id @default(uuid()) @db.Uuid
  campaignContactId       String                     @unique @db.Uuid
  currentState            OutreachSequenceState      @default(SMS_PENDING)
  version                 Int                        @default(1)
  /// Legacy RVM scheduling timestamp. New SMS-first sequences leave this null.
  rvmScheduledFor         DateTime?
  /// Legacy RVM attempt timestamp. Retained for historical attribution.
  rvmAttemptedAt          DateTime?
  /// Legacy RVM success timestamp. Retained for historical attribution.
  rvmSuccessfulAt         DateTime?
  /// Legacy external-SMS eligibility timestamp.
  smsEligibleAt           DateTime?
  smsScheduledFor         DateTime?
  /// Legacy external-SMS export timestamp.
  smsExportedAt           DateTime?
  smsSentAt               DateTime?
  smsRespondedAt          DateTime?
  smsToColdCallDelayHours Int                        @default(48)
  coldCallDueAt           DateTime?
  coldCallEligibleAt      DateTime?
  coldCallExportedAt      DateTime?
  nextEligibleAt          DateTime?
  terminalAt              DateTime?
  terminalReason          String?
  lastEventAt             DateTime                   @default(now())
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  campaignContact         CampaignContact            @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  events                  OutreachEvent[]
  exportItems             OutreachExportItem[]
  exportClaims            OutreachExportClaim[]
  externalOutcomeRows     ExternalOutcomeImportRow[]
  outboundMessages        SmsOutboundMessage[]

  @@index([currentState, nextEligibleAt])
  @@index([currentState, smsScheduledFor])
  @@index([currentState, coldCallDueAt])
  @@index([smsEligibleAt])
  @@index([coldCallEligibleAt])
  @@index([rvmScheduledFor])
}

model OutreachEvent {
  id               String                @id @default(uuid()) @db.Uuid
  sequenceId       String                @db.Uuid
  type             OutreachEventType
  channel          OutreachChannel
  resultingState   OutreachSequenceState
  outcome          String?
  source           String
  externalId       String?
  idempotencyKey   String                @unique
  actorUserId      String?               @db.Uuid
  rawPayload       Json?
  metadata         Json?
  occurredAt       DateTime
  recordedAt       DateTime              @default(now())
  sequence         OutreachSequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  actor            User?                 @relation("OutreachEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  leadAttributions LeadAttribution[]

  @@index([sequenceId, occurredAt])
  @@index([type, occurredAt])
  @@index([channel, outcome, occurredAt])
}

model SmsConversation {
  id                     String                @id @default(uuid()) @db.Uuid
  campaignContactId      String                @unique @db.Uuid
  providerKey            String?
  providerConversationId String?
  status                 SmsConversationStatus @default(OPEN)
  openedAt               DateTime              @default(now())
  lastMessageAt          DateTime?
  lastOutboundAt         DateTime?
  lastInboundAt          DateTime?
  closedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  campaignContact        CampaignContact       @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  outboundMessages       SmsOutboundMessage[]
  inboundMessages        SmsInboundMessage[]

  @@unique([providerKey, providerConversationId])
  @@index([status, lastMessageAt])
}

model SmsOutboundMessage {
  id                   String               @id @default(uuid()) @db.Uuid
  campaignContactId    String               @db.Uuid
  sequenceId           String               @db.Uuid
  conversationId       String?              @db.Uuid
  templateVersionId    String               @db.Uuid
  consentEvidenceId    String?              @db.Uuid
  sequenceNumber       Int                  @default(1)
  idempotencyKey       String               @unique
  toPhone              String
  fromPhone            String?
  renderedBody         String
  bodyHash             String
  segmentCount         Int                  @default(1)
  actualSegmentCount   Int?
  providerKey          String?
  providerMessageId    String?
  providerStatus       String?
  status               SmsMessageStatus     @default(PENDING)
  estimatedCostMicros  Int                  @default(0)
  actualCostMicros     Int?
  currency             String               @default("USD")
  complianceSnapshot   Json?
  suppressionCheckedAt DateTime?
  scheduledFor         DateTime?
  queuedAt             DateTime?
  submissionStartedAt  DateTime?
  acceptedAt           DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  repliedAt            DateTime?
  canceledAt           DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  campaignContact      CampaignContact      @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  sequence             OutreachSequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  conversation         SmsConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  templateVersion      SmsTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  consentEvidence      SmsConsentEvidence?  @relation(fields: [consentEvidenceId], references: [id], onDelete: SetNull)
  attempts             SmsOutboundAttempt[]
  statusEvents         SmsStatusEvent[]
  inboundReplies       SmsInboundMessage[]  @relation("SmsReplyToOutbound")
  usageLedger          SmsUsageLedger[]

  @@unique([campaignContactId, sequenceNumber])
  @@unique([providerKey, providerMessageId])
  @@index([status, scheduledFor])
  @@index([sequenceId, status])
  @@index([campaignContactId, status])
  @@index([providerKey, status, errorCode])
  @@index([providerKey, toPhone, fromPhone])
  @@index([conversationId, createdAt])
  @@index([templateVersionId])
  @@index([consentEvidenceId])
}

model SmsOutboundAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  messageId         String             @db.Uuid
  attemptNumber     Int
  idempotencyKey    String             @unique
  providerKey       String
  providerRequestId String?
  providerMessageId String?
  status            SmsAttemptStatus   @default(STARTED)
  requestPayload    Json?
  responsePayload   Json?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  createdAt         DateTime           @default(now())
  message           SmsOutboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, attemptNumber])
  @@unique([providerKey, providerMessageId])
  @@unique([providerKey, providerRequestId])
  @@index([messageId, status])
}

model SmsStatusEvent {
  id                String              @id @default(uuid()) @db.Uuid
  messageId         String?             @db.Uuid
  providerKey       String
  providerEventId   String
  providerMessageId String?
  status            SmsMessageStatus?
  providerStatus    String
  errorCode         String?
  errorMessage      String?
  rawPayload        Json
  occurredAt        DateTime?
  receivedAt        DateTime            @default(now())
  processedAt       DateTime?
  processingError   String?
  message           SmsOutboundMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([providerKey, providerEventId])
  @@index([messageId, occurredAt])
  @@index([providerKey, providerMessageId])
  @@index([providerKey, errorCode, processedAt])
  @@index([status, receivedAt])
}

model ProviderDiagnosticRun {
  id                       String                            @id @default(uuid()) @db.Uuid
  providerKey              String
  status                   ProviderDiagnosticStatus
  accountFingerprint       String
  serviceFingerprint       String
  configurationFingerprint String
  summary                  String
  details                  Json
  checkedAt                DateTime
  expiresAt                DateTime
  checkedByUserId          String                            @db.Uuid
  createdAt                DateTime                          @default(now())
  checkedBy                User                              @relation("ProviderDiagnosticCheckedBy", fields: [checkedByUserId], references: [id], onDelete: Restrict)
  approvalEvents           ProviderProductionApprovalEvent[]

  @@index([providerKey, checkedAt])
  @@index([providerKey, status, expiresAt])
  @@index([checkedByUserId, checkedAt])
}

model ProviderProductionApprovalEvent {
  id                       String                   @id @default(uuid()) @db.Uuid
  sequence                 BigInt                   @unique @default(autoincrement())
  providerKey              String
  decision                 ProviderApprovalDecision
  configurationFingerprint String
  diagnosticRunId          String?                  @db.Uuid
  actorUserId              String                   @db.Uuid
  note                     String?
  occurredAt               DateTime                 @default(now())
  diagnosticRun            ProviderDiagnosticRun?   @relation(fields: [diagnosticRunId], references: [id], onDelete: Restrict)
  actor                    User                     @relation("ProviderProductionApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([providerKey, sequence])
  @@index([actorUserId, occurredAt])
  @@index([diagnosticRunId])
}

model SmsInboundMessage {
  id                       String                   @id @default(uuid()) @db.Uuid
  conversationId           String?                  @db.Uuid
  contactId                String?                  @db.Uuid
  campaignContactId        String?                  @db.Uuid
  inReplyToMessageId       String?                  @db.Uuid
  providerKey              String
  providerMessageId        String
  fromPhone                String
  toPhone                  String
  body                     String
  classification           SmsInboundClassification @default(UNCLASSIFIED)
  classificationSource     String?
  classificationConfidence Decimal?                 @db.Decimal(5, 4)
  classifiedAt             DateTime?
  classifiedByUserId       String?                  @db.Uuid
  isOptOut                 Boolean                  @default(false)
  rawPayload               Json
  receivedAt               DateTime
  createdAt                DateTime                 @default(now())
  conversation             SmsConversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact                  Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaignContact          CampaignContact?         @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  inReplyToMessage         SmsOutboundMessage?      @relation("SmsReplyToOutbound", fields: [inReplyToMessageId], references: [id], onDelete: SetNull)
  classifiedBy             User?                    @relation("SmsInboundClassifier", fields: [classifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([providerKey, providerMessageId])
  @@index([conversationId, receivedAt])
  @@index([contactId, receivedAt])
  @@index([campaignContactId, receivedAt])
  @@index([fromPhone, receivedAt])
  @@index([toPhone, receivedAt])
  @@index([classification, receivedAt])
  @@index([inReplyToMessageId])
  @@index([classifiedByUserId])
}

model CampaignSuppression {
  id              String            @id @default(uuid()) @db.Uuid
  campaignId      String            @db.Uuid
  contactId       String?           @db.Uuid
  normalizedPhone String
  reason          SuppressionReason
  source          String?
  notes           String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("CampaignSuppressionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([campaignId, normalizedPhone])
  @@index([campaignId, reason, createdAt])
  @@index([contactId])
  @@index([createdByUserId])
}

model SmsConsentEvidence {
  id                String               @id @default(uuid()) @db.Uuid
  contactId         String               @db.Uuid
  campaignId        String?              @db.Uuid
  campaignContactId String?              @db.Uuid
  normalizedPhone   String
  status            SmsConsentStatus     @default(UNVERIFIED)
  basis             SmsConsentBasis      @default(UNKNOWN)
  source            String
  disclosureText    String?
  evidence          Json
  capturedAt        DateTime
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdByUserId   String?              @db.Uuid
  createdAt         DateTime             @default(now())
  contact           Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign          Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignContact   CampaignContact?     @relation(fields: [campaignContactId], references: [id], onDelete: SetNull)
  createdBy         User?                @relation("SmsConsentEvidenceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  outboundMessages  SmsOutboundMessage[]

  @@index([normalizedPhone, status, capturedAt])
  @@index([contactId, capturedAt])
  @@index([campaignId, status])
  @@index([campaignContactId])
  @@index([createdByUserId])
  @@index([status, expiresAt])
}

model SmsAuditEvent {
  id                String           @id @default(uuid()) @db.Uuid
  eventType         String
  entityType        String
  entityId          String
  campaignId        String?          @db.Uuid
  campaignContactId String?          @db.Uuid
  actorUserId       String?          @db.Uuid
