  rows            ExternalOutcomeImportRow[]

  @@index([channel, createdAt])
}

model ExternalOutcomeImportRow {
  id           String                   @id @default(uuid()) @db.Uuid
  importId     String                   @db.Uuid
  sequenceId   String?                  @db.Uuid
  rowNumber    Int
