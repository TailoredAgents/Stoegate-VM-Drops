generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
}

enum CampaignStatus {
  DRAFT
  DATA_READY
  PREVIEW_GENERATING
  PREVIEW_READY
  APPROVED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum ImportStatus {
  STAGING
  ANALYZED
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  ELIGIBLE
  INVALID_PHONE
  DUPLICATE_PHONE
  DUPLICATE_PHONE_PROPERTY
  SUPPRESSED
  MISSING_REQUIRED
}

enum CampaignContactStatus {
  ELIGIBLE
  AUDIO_PENDING
  AUDIO_READY
  QUEUED
  SENDING
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

enum AudioStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AudioBillingDisposition {
  BILLABLE_GENERATION
  DRY_RUN
}

enum DropStatus {
  PENDING
  DRY_RUN
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

enum CallbackOutcomeType {
  CALLBACK
  INTERESTED
  QUALIFIED_LEAD
  NOT_INTERESTED
  WRONG_NUMBER
  OPT_OUT
  FOLLOW_UP
  CONTRACT
  CLOSED
}

enum AttributionChannel {
  RVM_CALLBACK
  SMS
  COLD_CALL
  OTHER
}

enum OutreachChannel {
  RVM
  SMS
  COLD_CALL
  SYSTEM
}

enum OutreachSequenceState {
  RVM_PENDING
  RVM_SENT
  RVM_SUCCESS
  RVM_FAILED
  RVM_CALLBACK
  RVM_NO_RESPONSE
  SMS_NOT_YET_ELIGIBLE
  SMS_ELIGIBLE
  SMS_EXPORTED
  SMS_SENT_EXTERNAL
  SMS_REPLIED
  SMS_FAILED
  SMS_NO_RESPONSE
  COLD_CALL_NOT_YET_ELIGIBLE
  COLD_CALL_ELIGIBLE
  COLD_CALL_EXPORTED
  COLD_CALL_CONTACTED
  COLD_CALL_NO_ANSWER
  INTERESTED
  QUALIFIED_LEAD
  FOLLOW_UP
  NOT_INTERESTED
  WRONG_NUMBER
  OPT_OUT
  CONTRACT
  CLOSED
}

enum OutreachEventType {
  RVM_PENDING
  RVM_SENT
  RVM_SUCCESS
  RVM_FAILED
  RVM_CALLBACK
  RVM_NO_RESPONSE
  SMS_ELIGIBLE
  SMS_EXPORTED
  SMS_SENT_EXTERNAL
  SMS_REPLIED
  SMS_FAILED
  SMS_NO_RESPONSE
  COLD_CALL_ELIGIBLE
  COLD_CALL_EXPORTED
  COLD_CALL_CONTACTED
  COLD_CALL_NO_ANSWER
  OUTCOME_RECORDED
  SEQUENCE_EXITED
}

enum OutreachExportType {
  SMS_ELIGIBILITY
  BATCH_DIALER
}

enum ExternalOutcomeChannel {
  SMS
  COLD_CALL
}

enum ExternalOutcomeImportStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ExternalOutcomeRowStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
}

enum RvmUsageKind {
  ATTEMPT
  SUCCESS
}

enum SuppressionReason {
  OPT_OUT
  MANUAL
  WRONG_NUMBER
  PROVIDER_DNC
  COMPLIANCE
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique
  passwordHash           String
  role                   UserRole                @default(ADMIN)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  launchedCampaigns      Campaign[]              @relation("CampaignLaunchedBy")
  outreachEvents         OutreachEvent[]         @relation("OutreachEventActor")
  outreachExports        OutreachExport[]        @relation("OutreachExportCreator")
  externalOutcomeImports ExternalOutcomeImport[] @relation("ExternalOutcomeImportCreator")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String
  status                  CampaignStatus         @default(DRAFT)
  sendLimit               Int                    @default(2000)
  uploadedCount           Int                    @default(0)
  eligibleCount           Int                    @default(0)
  invalidCount            Int                    @default(0)
  duplicateCount          Int                    @default(0)
  suppressedCount         Int                    @default(0)
  scriptTemplateVersionId String?                @db.Uuid
  voiceConfigurationId    String?                @db.Uuid
  approvedAt              DateTime?
  launchedAt              DateTime?
  launchedByUserId        String?                @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  scriptTemplateVersion   ScriptTemplateVersion? @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration      VoiceConfiguration?    @relation(fields: [voiceConfigurationId], references: [id])
  launchedBy              User?                  @relation("CampaignLaunchedBy", fields: [launchedByUserId], references: [id], onDelete: SetNull)
  contacts                CampaignContact[]
  imports                 ImportBatch[]
  callbackOutcomes        CallbackOutcome[]
  outreachExports         OutreachExport[]
  leadAttributions        LeadAttribution[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([launchedByUserId])
}

model Contact {
  id              String             @id @default(uuid()) @db.Uuid
  normalizedPhone String             @unique
  firstName       String?
  lastName        String?
  ownerName       String?
  source          String?
  externalId      String?
  rawData         Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  properties      ContactProperty[]
  campaigns       CampaignContact[]
  suppressions    SuppressionEntry[]

  @@index([externalId])
}

model Property {
  id               String            @id @default(uuid()) @db.Uuid
  propertyAddress  String?
  streetName       String?
  city             String?
  state            String?
  postalCode       String?
  county           String?
  acreage          Decimal?          @db.Decimal(12, 3)
  propertyType     String?
  externalId       String?
  source           String?
  rawData          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         ContactProperty[]
  campaignContacts CampaignContact[]

  @@index([externalId])
  @@index([propertyAddress, city, state])
}

model ContactProperty {
  id         String   @id @default(uuid()) @db.Uuid
  contactId  String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([contactId, propertyId])
  @@index([propertyId])
}

model CampaignContact {
  id               String                @id @default(uuid()) @db.Uuid
  campaignId       String                @db.Uuid
  contactId        String                @db.Uuid
  propertyId       String?               @db.Uuid
  importRowId      String?               @unique @db.Uuid
  status           CampaignContactStatus @default(ELIGIBLE)
  isPreview        Boolean               @default(false)
  selectedForSend  Boolean               @default(false)
  renderedText     String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact          Contact               @relation(fields: [contactId], references: [id])
  property         Property?             @relation(fields: [propertyId], references: [id])
  importRow        ImportRow?            @relation(fields: [importRowId], references: [id])
  audioAssets      AudioAsset[]
  drops            Drop[]
  callbackOutcomes CallbackOutcome[]
  outreachSequence OutreachSequence?
  exportItems      OutreachExportItem[]
  leadAttribution  LeadAttribution?

  @@unique([campaignId, contactId, propertyId])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
  @@index([campaignId, isPreview])
  @@index([campaignId, selectedForSend, status])
}

model ScriptTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    ScriptTemplateVersion[]
}

model ScriptTemplateVersion {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @db.Uuid
  version     Int
  body        String
  createdAt   DateTime       @default(now())
  template    ScriptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  audioAssets AudioAsset[]

  @@unique([templateId, version])
}

model VoiceConfiguration {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  voiceId     String
  modelId     String
  settings    Json?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaigns   Campaign[]
  audioAssets AudioAsset[]
}

model AudioAsset {
  id                      String                  @id @default(uuid()) @db.Uuid
  campaignContactId       String                  @db.Uuid
  scriptTemplateVersionId String                  @db.Uuid
  voiceConfigurationId    String                  @db.Uuid
  renderedText            String
  textHash                String
  voiceId                 String
  modelId                 String
  characterCount          Int
  providerGenerationId    String?
  objectKey               String?
  contentType             String                  @default("audio/mpeg")
  durationSeconds         Float?
  estimatedCostCents      Int                     @default(0)
  billingDisposition      AudioBillingDisposition @default(BILLABLE_GENERATION)
  reuseCount              Int                     @default(0)
  status                  AudioStatus             @default(PENDING)
  generatedAt             DateTime?
  errorMessage            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  campaignContact         CampaignContact         @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  scriptTemplateVersion   ScriptTemplateVersion   @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration      VoiceConfiguration      @relation(fields: [voiceConfigurationId], references: [id])
  drops                   Drop[]
  generationUsages        AudioGenerationUsage[]

  @@unique([campaignContactId, textHash, voiceId, modelId])
  @@index([campaignContactId, status])
  @@index([textHash])
}

model AudioGenerationUsage {
  id                   String                  @id @default(uuid()) @db.Uuid
  audioAssetId         String                  @db.Uuid
  provider             String
  providerGenerationId String?
  characterCount       Int
  estimatedCostCents   Int                     @default(0)
  billingDisposition   AudioBillingDisposition
  generatedAt          DateTime
  storedAt             DateTime?
  storageError         String?
  createdAt            DateTime                @default(now())
  audioAsset           AudioAsset              @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)

  @@index([audioAssetId, generatedAt])
  @@index([billingDisposition, generatedAt])
}

model Drop {
  id                      String           @id @default(uuid()) @db.Uuid
  campaignContactId       String           @db.Uuid
  audioAssetId            String           @db.Uuid
  provider                String           @default("dropcowboy")
  providerMessageId       String?          @unique
  status                  DropStatus       @default(PENDING)
  providerResponse        Json?
  estimatedCostCents      Int              @default(0)
  providerUsageValueCents Int              @default(0)
  carrierDurationSeconds  Float?
  carrierDurationSource   String?
  queuedAt                DateTime?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  failedAt                DateTime?
  optedOutAt              DateTime?
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  campaignContact         CampaignContact  @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  audioAsset              AudioAsset       @relation(fields: [audioAssetId], references: [id])
  deliveryEvents          DeliveryEvent[]
  usageLedger             RvmUsageLedger[]

  @@unique([campaignContactId, provider])
  @@index([status, createdAt])
  @@index([campaignContactId])
}

model DeliveryEvent {
  id              String    @id @default(uuid()) @db.Uuid
  dropId          String    @db.Uuid
  providerEventId String    @unique
  eventType       String
  rawPayload      Json
  occurredAt      DateTime?
  receivedAt      DateTime  @default(now())
  drop            Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@index([dropId, receivedAt])
  @@index([eventType, receivedAt])
}

model CallbackOutcome {
  id                  String              @id @default(uuid()) @db.Uuid
  idempotencyKey      String              @unique
  campaignId          String?             @db.Uuid
  campaignContactId   String?             @db.Uuid
  normalizedPhone     String
  outcome             CallbackOutcomeType
  attributionChannel  AttributionChannel  @default(RVM_CALLBACK)
  stonegateLeadId     String?
  summary             String?
  callbackAt          DateTime
  contractAmountCents Int?
  revenueCents        Int?
  rawPayload          Json?
  createdAt           DateTime            @default(now())
  campaign            Campaign?           @relation(fields: [campaignId], references: [id])
  campaignContact     CampaignContact?    @relation(fields: [campaignContactId], references: [id])

  @@index([normalizedPhone, callbackAt])
  @@index([campaignId, outcome])
}

model OutreachSequence {
  id                  String                     @id @default(uuid()) @db.Uuid
  campaignContactId   String                     @unique @db.Uuid
  currentState        OutreachSequenceState      @default(RVM_PENDING)
  version             Int                        @default(1)
  rvmScheduledFor     DateTime?
  rvmAttemptedAt      DateTime?
  rvmSuccessfulAt     DateTime?
  smsEligibleAt       DateTime?
  smsExportedAt       DateTime?
  smsSentAt           DateTime?
  smsRespondedAt      DateTime?
  coldCallEligibleAt  DateTime?
  coldCallExportedAt  DateTime?
  nextEligibleAt      DateTime?
  terminalAt          DateTime?
  terminalReason      String?
  lastEventAt         DateTime                   @default(now())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  campaignContact     CampaignContact            @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  events              OutreachEvent[]
  exportItems         OutreachExportItem[]
  exportClaims        OutreachExportClaim[]
  externalOutcomeRows ExternalOutcomeImportRow[]

  @@index([currentState, nextEligibleAt])
  @@index([smsEligibleAt])
  @@index([coldCallEligibleAt])
  @@index([rvmScheduledFor])
}

model OutreachEvent {
  id               String                @id @default(uuid()) @db.Uuid
  sequenceId       String                @db.Uuid
  type             OutreachEventType
  channel          OutreachChannel
  resultingState   OutreachSequenceState
  outcome          String?
  source           String
  externalId       String?
  idempotencyKey   String                @unique
  actorUserId      String?               @db.Uuid
  rawPayload       Json?
  metadata         Json?
  occurredAt       DateTime
  recordedAt       DateTime              @default(now())
  sequence         OutreachSequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  actor            User?                 @relation("OutreachEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  leadAttributions LeadAttribution[]

  @@index([sequenceId, occurredAt])
  @@index([type, occurredAt])
  @@index([channel, outcome, occurredAt])
}

model LeadAttribution {
  id                String             @id @default(uuid()) @db.Uuid
  campaignContactId String             @unique @db.Uuid
  campaignId        String             @db.Uuid
  creditedChannel   AttributionChannel
  creditedEventId   String?            @db.Uuid
  qualifyingOutcome String
  attributedAt      DateTime
  createdAt         DateTime           @default(now())
  campaignContact   CampaignContact    @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creditedEvent     OutreachEvent?     @relation(fields: [creditedEventId], references: [id], onDelete: SetNull)

  @@index([campaignId, creditedChannel])
  @@index([creditedChannel, attributedAt])
}

model OutreachExport {
  id                String                @id @default(uuid()) @db.Uuid
  idempotencyKey    String                @unique
  type              OutreachExportType
  campaignId        String?               @db.Uuid
  createdByUserId   String                @db.Uuid
  filename          String
  itemCount         Int                   @default(0)
  intentionalRepeat Boolean               @default(false)
  repeatReason      String?
  filtersSnapshot   Json?
  createdAt         DateTime              @default(now())
  campaign          Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy         User                  @relation("OutreachExportCreator", fields: [createdByUserId], references: [id])
  items             OutreachExportItem[]
  claims            OutreachExportClaim[]

  @@index([type, createdAt])
  @@index([campaignId, createdAt])
}

model OutreachExportItem {
  id                String           @id @default(uuid()) @db.Uuid
  exportId          String           @db.Uuid
  sequenceId        String           @db.Uuid
  campaignContactId String           @db.Uuid
  occurrence        Int              @default(1)
  rowSnapshot       Json
  createdAt         DateTime         @default(now())
  export            OutreachExport   @relation(fields: [exportId], references: [id], onDelete: Cascade)
  sequence          OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  campaignContact   CampaignContact  @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)

  @@unique([exportId, sequenceId])
  @@index([sequenceId, createdAt])
  @@index([campaignContactId])
}

model OutreachExportClaim {
  id            String             @id @default(uuid()) @db.Uuid
  sequenceId    String             @db.Uuid
  type          OutreachExportType
  firstExportId String             @db.Uuid
  claimedAt     DateTime           @default(now())
  sequence      OutreachSequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  firstExport   OutreachExport     @relation(fields: [firstExportId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, type])
  @@index([firstExportId])
}

model ExternalOutcomeImport {
  id              String                      @id @default(uuid()) @db.Uuid
  channel         ExternalOutcomeChannel
  fileName        String
  status          ExternalOutcomeImportStatus @default(PROCESSING)
  createdByUserId String                      @db.Uuid
  totalCount      Int                         @default(0)
  acceptedCount   Int                         @default(0)
  rejectedCount   Int                         @default(0)
  createdAt       DateTime                    @default(now())
  completedAt     DateTime?
  createdBy       User                        @relation("ExternalOutcomeImportCreator", fields: [createdByUserId], references: [id])
  rows            ExternalOutcomeImportRow[]

  @@index([channel, createdAt])
}

model ExternalOutcomeImportRow {
  id           String                   @id @default(uuid()) @db.Uuid
  importId     String                   @db.Uuid
  sequenceId   String?                  @db.Uuid
  rowNumber    Int
  status       ExternalOutcomeRowStatus
  result       String?
  externalId   String?
  occurredAt   DateTime?
  errorMessage String?
  rawData      Json
  createdAt    DateTime                 @default(now())
  import       ExternalOutcomeImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  sequence     OutreachSequence?        @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([sequenceId])
}

model ProviderBillingPeriod {
  id                   String   @id @default(uuid()) @db.Uuid
  providerKey          String
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  pricingSnapshot      Json
  actualInvoiceCents   Int?
  actualCarrierSeconds Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([providerKey, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

model RvmDailyUsage {
  id              String           @id @default(uuid()) @db.Uuid
  localDate       DateTime         @db.Date
  timezone        String
  cap             Int
  attemptedCount  Int              @default(0)
  successfulCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         RvmUsageLedger[]

  @@unique([localDate, timezone])
  @@index([timezone, localDate])
}

model RvmUsageLedger {
  id           String        @id @default(uuid()) @db.Uuid
  dailyUsageId String        @db.Uuid
  dropId       String        @db.Uuid
  kind         RvmUsageKind
  occurredAt   DateTime
  createdAt    DateTime      @default(now())
  dailyUsage   RvmDailyUsage @relation(fields: [dailyUsageId], references: [id], onDelete: Cascade)
  drop         Drop          @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, kind])
  @@index([dailyUsageId, kind])
  @@index([kind, occurredAt])
}

model SuppressionEntry {
  id              String            @id @default(uuid()) @db.Uuid
  normalizedPhone String            @unique
  contactId       String?           @db.Uuid
  reason          SuppressionReason
  source          String?
  notes           String?
  createdAt       DateTime          @default(now())
  contact         Contact?          @relation(fields: [contactId], references: [id])

  @@index([reason, createdAt])
}

model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model ImportBatch {
  id              String       @id @default(uuid()) @db.Uuid
  campaignId      String?      @db.Uuid
  fileName        String
  status          ImportStatus @default(STAGING)
  columnMapping   Json
  uploadedCount   Int          @default(0)
  eligibleCount   Int          @default(0)
  invalidCount    Int          @default(0)
  duplicateCount  Int          @default(0)
  suppressedCount Int          @default(0)
  missingCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  committedAt     DateTime?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  rows            ImportRow[]

  @@index([status, createdAt])
}

model ImportRow {
  id              String           @id @default(uuid()) @db.Uuid
  importBatchId   String           @db.Uuid
  rowNumber       Int
  status          ImportRowStatus
  normalizedPhone String?
  mappedData      Json
  rawData         Json
  errorMessage    String?
  createdAt       DateTime         @default(now())
  importBatch     ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact?

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([normalizedPhone])
}

model JobRun {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @unique
  queue        String
  campaignId   String?   @db.Uuid
  entityId     String?   @db.Uuid
  status       String
  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId, createdAt])
  @@index([queue, status])
}
