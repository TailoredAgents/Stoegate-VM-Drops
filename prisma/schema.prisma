/// Legacy RVM/carrier billing-period snapshot. Retained for historical economics.
model ProviderBillingPeriod {
  id                   String   @id @default(uuid()) @db.Uuid
  providerKey          String
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  pricingSnapshot      Json
  actualInvoiceCents   Int?
  actualCarrierSeconds Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([providerKey, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

/// Legacy RVM daily counter. Retained read-only for historical operating records.
model RvmDailyUsage {
  id              String           @id @default(uuid()) @db.Uuid
  localDate       DateTime         @db.Date
  timezone        String
  cap             Int
  attemptedCount  Int              @default(0)
  successfulCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         RvmUsageLedger[]

  @@unique([localDate, timezone])
  @@index([timezone, localDate])
}

/// Legacy RVM usage ledger. Retained read-only for immutable historical audit.
model RvmUsageLedger {
  id           String        @id @default(uuid()) @db.Uuid
  dailyUsageId String        @db.Uuid
  dropId       String        @db.Uuid
  kind         RvmUsageKind
  occurredAt   DateTime
  createdAt    DateTime      @default(now())
  dailyUsage   RvmDailyUsage @relation(fields: [dailyUsageId], references: [id], onDelete: Cascade)
  drop         Drop          @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, kind])
  @@index([dailyUsageId, kind])
  @@index([kind, occurredAt])
}

/// Global, cross-campaign suppression. Campaign-specific blocks use CampaignSuppression.
model SuppressionEntry {
  id              String            @id @default(uuid()) @db.Uuid
  normalizedPhone String            @unique
  contactId       String?           @db.Uuid
  reason          SuppressionReason
  source          String?
  notes           String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contact         Contact?          @relation(fields: [contactId], references: [id])
  createdBy       User?             @relation("GlobalSuppressionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([reason, createdAt])
  @@index([createdByUserId])
}

model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model ImportBatch {
  id              String       @id @default(uuid()) @db.Uuid
  campaignId      String?      @db.Uuid
  fileName        String
  status          ImportStatus @default(STAGING)
  columnMapping   Json
  uploadedCount   Int          @default(0)
  eligibleCount   Int          @default(0)
  invalidCount    Int          @default(0)
  duplicateCount  Int          @default(0)
  suppressedCount Int          @default(0)
  missingCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  committedAt     DateTime?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  rows            ImportRow[]

