generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
}

enum CampaignStatus {
  DRAFT
  DATA_READY
  PREVIEW_GENERATING
  PREVIEW_READY
  APPROVED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum ImportStatus {
  STAGING
  ANALYZED
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  ELIGIBLE
  INVALID_PHONE
  DUPLICATE_PHONE
  DUPLICATE_PHONE_PROPERTY
  SUPPRESSED
  MISSING_REQUIRED
}

enum CampaignContactStatus {
  ELIGIBLE
  AUDIO_PENDING
  AUDIO_READY
  QUEUED
  SENDING
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

enum AudioStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum DropStatus {
  PENDING
  DRY_RUN
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPTED_OUT
  SKIPPED
}

enum CallbackOutcomeType {
  CALLBACK
  INTERESTED
  QUALIFIED_LEAD
  NOT_INTERESTED
  WRONG_NUMBER
  OPT_OUT
  FOLLOW_UP
  CONTRACT
  CLOSED
}

enum SuppressionReason {
  OPT_OUT
  MANUAL
  WRONG_NUMBER
  PROVIDER_DNC
  COMPLIANCE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  launchedCampaigns Campaign[] @relation("CampaignLaunchedBy")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String
  status                  CampaignStatus         @default(DRAFT)
  sendLimit               Int                    @default(1000)
  uploadedCount           Int                    @default(0)
  eligibleCount           Int                    @default(0)
  invalidCount            Int                    @default(0)
  duplicateCount          Int                    @default(0)
  suppressedCount         Int                    @default(0)
  scriptTemplateVersionId String?                @db.Uuid
  voiceConfigurationId    String?                @db.Uuid
  approvedAt              DateTime?
  launchedAt              DateTime?
  launchedByUserId        String?                @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  scriptTemplateVersion   ScriptTemplateVersion? @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration      VoiceConfiguration?    @relation(fields: [voiceConfigurationId], references: [id])
  launchedBy              User?                  @relation("CampaignLaunchedBy", fields: [launchedByUserId], references: [id], onDelete: SetNull)
  contacts                CampaignContact[]
  imports                 ImportBatch[]
  callbackOutcomes        CallbackOutcome[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([launchedByUserId])
}

model Contact {
  id              String             @id @default(uuid()) @db.Uuid
  normalizedPhone String             @unique
  firstName       String?
  lastName        String?
  ownerName       String?
  source          String?
  externalId      String?
  rawData         Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  properties      ContactProperty[]
  campaigns       CampaignContact[]
  suppressions    SuppressionEntry[]

  @@index([externalId])
}

model Property {
  id               String            @id @default(uuid()) @db.Uuid
  propertyAddress  String?
  streetName       String?
  city             String?
  state            String?
  postalCode       String?
  county           String?
  acreage          Decimal?          @db.Decimal(12, 3)
  propertyType     String?
  externalId       String?
  source           String?
  rawData          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         ContactProperty[]
  campaignContacts CampaignContact[]

  @@index([externalId])
  @@index([propertyAddress, city, state])
}

model ContactProperty {
  id         String   @id @default(uuid()) @db.Uuid
  contactId  String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([contactId, propertyId])
  @@index([propertyId])
}

model CampaignContact {
  id               String                @id @default(uuid()) @db.Uuid
  campaignId       String                @db.Uuid
  contactId        String                @db.Uuid
  propertyId       String?               @db.Uuid
  importRowId      String?               @unique @db.Uuid
  status           CampaignContactStatus @default(ELIGIBLE)
  isPreview        Boolean               @default(false)
  selectedForSend  Boolean               @default(false)
  renderedText     String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact          Contact               @relation(fields: [contactId], references: [id])
  property         Property?             @relation(fields: [propertyId], references: [id])
  importRow        ImportRow?            @relation(fields: [importRowId], references: [id])
  audioAssets      AudioAsset[]
  drops            Drop[]
  callbackOutcomes CallbackOutcome[]

  @@unique([campaignId, contactId, propertyId])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
  @@index([campaignId, isPreview])
  @@index([campaignId, selectedForSend, status])
}

model ScriptTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    ScriptTemplateVersion[]
}

model ScriptTemplateVersion {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @db.Uuid
  version     Int
  body        String
  createdAt   DateTime       @default(now())
  template    ScriptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  audioAssets AudioAsset[]

  @@unique([templateId, version])
}

model VoiceConfiguration {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  voiceId     String
  modelId     String
  settings    Json?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaigns   Campaign[]
  audioAssets AudioAsset[]
}

model AudioAsset {
  id                      String                @id @default(uuid()) @db.Uuid
  campaignContactId       String                @db.Uuid
  scriptTemplateVersionId String                @db.Uuid
  voiceConfigurationId    String                @db.Uuid
  renderedText            String
  textHash                String
  voiceId                 String
  modelId                 String
  characterCount          Int
  providerGenerationId    String?
  objectKey               String?
  contentType             String                @default("audio/mpeg")
  durationSeconds         Float?
  estimatedCostCents      Int                   @default(0)
  status                  AudioStatus           @default(PENDING)
  generatedAt             DateTime?
  errorMessage            String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  campaignContact         CampaignContact       @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  scriptTemplateVersion   ScriptTemplateVersion @relation(fields: [scriptTemplateVersionId], references: [id])
  voiceConfiguration      VoiceConfiguration    @relation(fields: [voiceConfigurationId], references: [id])
  drops                   Drop[]

  @@unique([campaignContactId, textHash, voiceId, modelId])
  @@index([campaignContactId, status])
  @@index([textHash])
}

model Drop {
  id                 String          @id @default(uuid()) @db.Uuid
  campaignContactId  String          @db.Uuid
  audioAssetId       String          @db.Uuid
  provider           String          @default("dropcowboy")
  providerMessageId  String?         @unique
  status             DropStatus      @default(PENDING)
  providerResponse   Json?
  estimatedCostCents Int             @default(0)
  queuedAt           DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  optedOutAt         DateTime?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  campaignContact    CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  audioAsset         AudioAsset      @relation(fields: [audioAssetId], references: [id])
  deliveryEvents     DeliveryEvent[]

  @@unique([campaignContactId, provider])
  @@index([status, createdAt])
  @@index([campaignContactId])
}

model DeliveryEvent {
  id              String    @id @default(uuid()) @db.Uuid
  dropId          String    @db.Uuid
  providerEventId String    @unique
  eventType       String
  rawPayload      Json
  occurredAt      DateTime?
  receivedAt      DateTime  @default(now())
  drop            Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@index([dropId, receivedAt])
  @@index([eventType, receivedAt])
}

model CallbackOutcome {
  id                  String              @id @default(uuid()) @db.Uuid
  idempotencyKey      String              @unique
  campaignId          String?             @db.Uuid
  campaignContactId   String?             @db.Uuid
  normalizedPhone     String
  outcome             CallbackOutcomeType
  stonegateLeadId     String?
  summary             String?
  callbackAt          DateTime
  contractAmountCents Int?
  revenueCents        Int?
  rawPayload          Json?
  createdAt           DateTime            @default(now())
  campaign            Campaign?           @relation(fields: [campaignId], references: [id])
  campaignContact     CampaignContact?    @relation(fields: [campaignContactId], references: [id])

  @@index([normalizedPhone, callbackAt])
  @@index([campaignId, outcome])
}

model SuppressionEntry {
  id              String            @id @default(uuid()) @db.Uuid
  normalizedPhone String            @unique
  contactId       String?           @db.Uuid
  reason          SuppressionReason
  source          String?
  notes           String?
  createdAt       DateTime          @default(now())
  contact         Contact?          @relation(fields: [contactId], references: [id])

  @@index([reason, createdAt])
}

model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model ImportBatch {
  id              String       @id @default(uuid()) @db.Uuid
  campaignId      String?      @db.Uuid
  fileName        String
  status          ImportStatus @default(STAGING)
  columnMapping   Json
  uploadedCount   Int          @default(0)
  eligibleCount   Int          @default(0)
  invalidCount    Int          @default(0)
  duplicateCount  Int          @default(0)
  suppressedCount Int          @default(0)
  missingCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  committedAt     DateTime?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
  rows            ImportRow[]

  @@index([status, createdAt])
}

model ImportRow {
  id              String           @id @default(uuid()) @db.Uuid
  importBatchId   String           @db.Uuid
  rowNumber       Int
  status          ImportRowStatus
  normalizedPhone String?
  mappedData      Json
  rawData         Json
  errorMessage    String?
  createdAt       DateTime         @default(now())
  importBatch     ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact?

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([normalizedPhone])
}

model JobRun {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @unique
  queue        String
  campaignId   String?   @db.Uuid
  entityId     String?   @db.Uuid
  status       String
  attempts     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId, createdAt])
  @@index([queue, status])
}
