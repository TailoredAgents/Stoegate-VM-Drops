# Core application
NODE_ENV=development
# The database name remains stable for compatibility with the existing Render resource.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stonegate_vm_drops?schema=public
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
ADMIN_EMAIL=admin@example.com
# Used only by `npm run db:seed`; prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_PASSWORD_HASH=

# Optional admin-only AI assistance. This creates an unapproved template draft;
# it never receives contact rows and is never called by the sending worker.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TEMPLATE_DRAFTING_ENABLED=false

# SMS safety defaults. Keep both values as shown until the controlled Twilio
# acceptance test has been explicitly approved.
SMS_LIVE_SENDS_ENABLED=false
SMS_PROVIDER=dry-run
# Optional authentication for the provider-neutral canonical webhook. Twilio's
# native routes use X-Twilio-Signature instead.
# SMS_PROVIDER_WEBHOOK_SECRET=
DEFAULT_DAILY_SMS_LIMIT=2000
MAX_LIVE_SMS_CAMPAIGN_LIMIT=10
MAX_LIVE_DAILY_SMS_LIMIT=10
DEFAULT_SMS_TO_COLD_CALL_DELAY_HOURS=48

# Twilio Programmable Messaging (leave blank in dry-run)
# The Account SID and Messaging Service SID are identifiers. The Auth Token is
# a secret and must never be committed. Credentials alone cannot enable sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PRODUCTION_APPROVED=false

# Worker and logging
WORKER_CONCURRENCY=4
LOG_LEVEL=info

# Integration tests only. The runner refuses DATABASE_URL and requires a
# test-named database unless explicitly acknowledged.
TEST_DATABASE_URL=
ALLOW_DISPOSABLE_TEST_DATABASE=false
