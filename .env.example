# Core application
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stonegate_vm_drops?schema=public
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
ADMIN_EMAIL=admin@example.com
# Used only by `npm run db:seed`; prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_PASSWORD_HASH=

# ElevenLabs (optional while live sends are disabled)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Cloudflare R2 (optional while live sends are disabled)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PRESIGNED_URL_TTL_SECONDS=86400

# Drop Cowboy (optional while live sends are disabled)
DROP_COWBOY_API_ENDPOINT=https://api.dropcowboy.com/v1/rvm
DROP_COWBOY_TEAM_ID=
DROP_COWBOY_SECRET=
DROP_COWBOY_BRAND_ID=
DROP_COWBOY_FORWARDING_NUMBER=
DROP_COWBOY_WEBHOOK_SECRET=

# Stonegate OS callback integration
STONEGATE_INTEGRATION_API_KEY=replace-with-a-separate-long-random-key
CALLBACK_LOOKBACK_DAYS=30

# Safety and workers
# Enables real ElevenLabs generation and R2 storage while keeping voicemail simulation safe.
AUDIO_GENERATION_LIVE_ENABLED=false
RVM_LIVE_SENDS_ENABLED=false
# Keep this at 10 for the first production validation; raise only after an explicit operational review.
MAX_LIVE_CAMPAIGN_SEND_LIMIT=10
# Independent hard ceiling for all campaigns combined in one local operating day.
MAX_LIVE_DAILY_RVM_ATTEMPTS=10
WORKER_CONCURRENCY=4
DEFAULT_CAMPAIGN_SEND_LIMIT=2000
PREVIEW_SAMPLE_SIZE=10
LOG_LEVEL=info

# Integration tests only. The runner refuses DATABASE_URL and requires a test-named database unless explicitly acknowledged.
TEST_DATABASE_URL=
ALLOW_DISPOSABLE_TEST_DATABASE=false
